      "id": "02-read-leads",
      "name": "Read Qualified Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        120,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const init = $('Initialize Run').first().json;\nconst minScore = Number($('CREDENCIALS').first().json.min_qualified_score || 65);\nconst out = [];\n\nfor (const item of $input.all()) {\n  const lead = item.json;\n  const score = Number(lead.score || 0);\n  if (score < minScore) continue;\n  if (!['A', 'B'].includes(String(lead.priority || '').trim())) continue;\n  if (!String(lead.decision_maker_name || '').trim()) continue;\n  if (!String(lead.decision_maker_role || '').trim()) continue;\n  if (String(lead.email || '').trim()) continue;\n  if (String(lead.enrichment_status || '').trim() !== 'Pending') continue;\n  out.push({ json: { ...lead, run_id: init.run_id, workflow_name: init.workflow_name, started_at: init.started_at } });\n}\n\nreturn out;"
      },
