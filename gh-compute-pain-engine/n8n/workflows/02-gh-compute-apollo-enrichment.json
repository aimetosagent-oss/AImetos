    {
      "parameters": {
        "jsCode": "const now = new Date().toISOString();\nconst cred = $input.first().json;\nreturn [{ json: { ...cred, run_id: `apollo-${now.replace(/[^0-9]/g, '').slice(0, 14)}-${Math.random().toString(36).slice(2, 8)}`, workflow_name: 'GH Compute — Apollo Optional Enrichment', started_at: now } }];"
      },
      "id": "02-init",
      "name": "Initialize Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -760,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $('CREDENCIALS').first().json.google_sheet_id }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $('CREDENCIALS').first().json.config_sheet_name }}",
          "mode": "name"
        },
        "options": {}
      },
      "id": "02-read-config",
      "name": "Read Config",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -540,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const init = $('Initialize Run').first().json;\nconst cred = $('CREDENCIALS').first().json;\nconst cfg = {};\nfor (const item of $input.all()) {\n  const key = String(item.json.key || '').trim();\n  if (key) cfg[key] = item.json.value || '';\n}\n\nconst configEnabled = String(cfg.APOLLO_ENABLED ?? '').trim().toLowerCase() === 'true';\nconst credentialEnabled = String(cred.apollo_enabled ?? '').trim().toLowerCase() === 'true';\nconst enabled = configEnabled || credentialEnabled;\nconst apiKeyEnvVar = String(cfg.APOLLO_API_KEY_ENV_VAR || cred.apollo_api_key_env_var || 'APOLLO_API_KEY').trim();\nconst endpointEnvVar = String(cfg.APOLLO_ENRICH_ENDPOINT_ENV_VAR || cred.apollo_enrich_endpoint_env_var || 'APOLLO_ENRICH_ENDPOINT').trim();\nconst skipped = [];\n\nif (!enabled) skipped.push('Apollo disabled: set APOLLO_ENABLED=TRUE in 00_CONFIG or apollo_enabled=true in CREDENCIALS');\nif (!$env[apiKeyEnvVar]) skipped.push(apiKeyEnvVar + ' is empty');\nif (!$env[endpointEnvVar]) skipped.push(endpointEnvVar + ' is empty');\n\nif (skipped.length) {\n  return [{\n    json: {\n      ...init,\n      proceed: false,\n      apollo_api_key_env_var: apiKeyEnvVar,\n      apollo_enrich_endpoint_env_var: endpointEnvVar,\n      finished_at: new Date().toISOString(),\n      status: 'Skipped',\n      sources_requested: 0,\n      raw_items: 0,\n      new_signals: 0,\n      qualified_leads: 0,\n      errors: '',\n      details: skipped.join('; ')\n    }\n  }];\n}\n\nreturn [{ json: { ...init, proceed: true, apollo_api_key_env_var: apiKeyEnvVar, apollo_enrich_endpoint_env_var: endpointEnvVar } }];"
      },
