    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env[$json.apollo_enrich_endpoint_env_var || 'APOLLO_ENRICH_ENDPOINT'] }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[$json.apollo_api_key_env_var || 'APOLLO_API_KEY'] }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ name: $json.decision_maker_name, role: $json.decision_maker_role, company: $json.company_name, domain: $json.domain, website: $json.website }) }}",
        "options": {
          "timeout": 70000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "02-call-apollo",
      "name": "Call Apollo Enrichment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        -100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Filter Apollo Candidates').item.json;\nconst response = $input.first().json;\nconst body = response.body || response;\nconst findEmail = (value) => {\n  if (!value) return '';\n  if (typeof value === 'string') return (/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(value.trim()) ? value.trim() : '');\n  if (Array.isArray(value)) return value.map(findEmail).find(Boolean) || '';\n  if (typeof value === 'object') return findEmail(value.email || value.work_email || value.email_address || value.person?.email || value.contact?.email || Object.values(value));\n  return '';\n};\nconst email = findEmail(body);\nreturn [{ json: { lead_id: lead.lead_id, email, email_source: email ? 'Apollo' : lead.email_source || '', enrichment_status: email ? 'Enriched' : 'No email found', updated_at: new Date().toISOString() } }];"
      },
