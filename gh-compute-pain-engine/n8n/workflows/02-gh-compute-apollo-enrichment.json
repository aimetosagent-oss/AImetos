      "id": "02-read-config",
      "name": "Read Config",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -540,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const init = $('Initialize Run').first().json;\nconst cfg = {};\nfor (const item of $input.all()) {\n  const key = String(item.json.key || '').trim();\n  if (key) cfg[key] = item.json.value || '';\n}\nconst enabled = String(cfg.APOLLO_ENABLED ?? '').trim().toLowerCase() === 'true';\nconst apiKeyEnvVar = String(cfg.APOLLO_API_KEY_ENV_VAR || 'APOLLO_API_KEY').trim();\nconst endpointEnvVar = String(cfg.APOLLO_ENRICH_ENDPOINT_ENV_VAR || 'APOLLO_ENRICH_ENDPOINT').trim();\nconst skipped = [];\nif (!enabled) skipped.push('APOLLO_ENABLED is not true in 00_CONFIG');\nif (!$env[apiKeyEnvVar]) skipped.push(apiKeyEnvVar + ' is empty');\nif (!$env[endpointEnvVar]) skipped.push(endpointEnvVar + ' is empty');\nif (skipped.length) {\n  return [{ json: { ...init, proceed: false, apollo_api_key_env_var: apiKeyEnvVar, apollo_enrich_endpoint_env_var: endpointEnvVar, finished_at: new Date().toISOString(), status: 'Skipped', sources_requested: 0, raw_items: 0, new_signals: 0, qualified_leads: 0, errors: '', details: skipped.join('; ') } }];\n}\nreturn [{ json: { ...init, proceed: true, apollo_api_key_env_var: apiKeyEnvVar, apollo_enrich_endpoint_env_var: endpointEnvVar } }];"
      },
