    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst cred = $('CREDENCIALS').first().json;\nconst now = new Date().toISOString();\nconst workflow = payload.workflow || {};\nconst execution = payload.execution || {};\nconst error = payload.error || {};\nconst baseUrl = $env[cred.n8n_editor_base_url_env_var || 'N8N_EDITOR_BASE_URL'] || '';\nconst executionId = execution.id || payload.executionId || '';\nconst executionUrl = baseUrl && executionId ? baseUrl.replace(/\\/$/, '') + '/workflow/' + (workflow.id || '') + '/executions/' + executionId : '';\nreturn [{ json: { ...cred, run_id: 'error-' + now.replace(/[^0-9]/g, '').slice(0, 14) + '-' + Math.random().toString(36).slice(2, 8), workflow_name: workflow.name || payload.workflowName || 'Unknown workflow', started_at: now, finished_at: now, status: 'Failed', sources_requested: 0, raw_items: 0, new_signals: 0, qualified_leads: 0, errors: error.message || payload.message || 'Unknown n8n execution error', details: JSON.stringify({ execution_id: executionId, execution_url: executionUrl, timestamp: now }) } }];"
      },
