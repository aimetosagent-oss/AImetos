APOLLO_API_KEY=

# AImetos CRM
DATABASE_URL=postgresql://aimetos:aimetos@postgres:5432/aimetos_crm?schema=public
DIRECT_DATABASE_URL=postgresql://aimetos:aimetos@postgres:5432/aimetos_crm?schema=public
# Opcional per a `prisma migrate dev`; a Docker `migrate deploy` no l'utilitza.
SHADOW_DATABASE_URL=postgresql://aimetos:aimetos@postgres:5432/aimetos_crm_shadow?schema=public
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@aimetos.local
ADMIN_PASSWORD=AdminAimetos2026!
ADMIN_NAME=Administrador AImetos
ORGANIZATION_TIMEZONE=Europe/Madrid
ORGANIZATION_CURRENCY=EUR

# 0 ignora X-Forwarded-For. Configureu el nombre exacte de proxies de confiança
# (normalment 1 a EasyPanel) i no exposeu el port de l'app directament.
PUBLIC_FORM_TRUSTED_PROXY_HOPS=0
AUTH_TRUSTED_PROXY_HOPS=0

# Worker
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_MS=2000
WORKER_LOCK_TIMEOUT_MINUTES=10

# SMTP (Mailpit local)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=AImetos
SMTP_FROM_EMAIL=crm@aimetos.local

# Stripe: només claus test (sk_test_ / pk_test_)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Xifrat de secrets de webhooks sortints (32 bytes en base64)
INTEGRATION_ENCRYPTION_KEY=

# Docker / inici controlat
POSTGRES_DB=aimetos_crm
POSTGRES_USER=aimetos
POSTGRES_PASSWORD=aimetos
SEED_ON_START=false
SEED_DEMO_DATA=true
