      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $('SET — CONFIG').first().json.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
