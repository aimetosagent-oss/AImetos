      "id": "11323917-c226-431c9-8b0cc-26f1f2a19aa4",
      "name": "Read CONFIG_CAMPAIGNS",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -600,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst truthy = (value) => value === true || ['true', '1', 'yes', 'si', 'sí'].includes(String(value ?? '').trim().toLowerCase());\nconst text = (value) => String(value ?? '').trim();\nconst number = (value, fallback = 0) => Number.isFinite(Number(value)) ? Number(value) : fallback;\n\nreturn $input.all()\n  .map((item) => item.json || {})\n  .filter((row) => truthy(row.active))\n  .filter((row) => text(row.source_type).toLowerCase() === 'apify')\n  .map((row) => ({\n    json: {\n      ...row,\n      campaign_key: text(row.campaign_key),\n      sheet_name: text(row.sheet_name),\n      source_type: text(row.source_type).toLowerCase(),\n      sending_platform: text(row.sending_platform).toLowerCase(),\n      platform_campaign_id: text(row.platform_campaign_id),\n      batch_limit: Math.max(1, Math.floor(number(row.daily_limit_per_account, 1) * number(row.accounts_count, 1))),\n      requires_email_verification: truthy(row.requires_email_verification),\n    },\n  }));\n"
      },
      "id": "6383760a-3531-4e2e2-86fce-7d4a0ee0a725",
      "name": "Select campaigns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -360,
        200
      ]
    },
    {
